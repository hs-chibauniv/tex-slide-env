    // report templates
    "report":{
        "prefix": "report_simple",
        "body": [
            "%A4: 21.0 x 29.7cm",
            "\\documentclass[a4paper,11pt]{ltjsarticle}",
            "",
            "% 数式",
            "\\usepackage{amsmath,amsfonts}",
			"\\usepackage{mathtools}",
            "\\usepackage{bm}",
            "% 画像",
            "\\usepackage{graphics}",
            "\\usepackage{graphicx}",
            "\\usepackage{here} %画像の表示位置調整用",
            "\\usepackage{setspace}",
            "% 句読点",
            "\\directlua{",
            "    luatexbase.add_to_callback(\"process_input_buffer\", function(line)",
            "      line = line:gsub(\"、\", \"，\")",
            "      line = line:gsub(\"。\", \"．\")",
            "      return line",
            "    end, \"replace_kuten_and_touten\")",
            "}",
            "${4}",
            "",
            "\\begin{document}",
            "",
            "% 目次",
            "\\tableofcontents",
            "\\newpage",
            "",
            "% 本文",
            "$0",
            "",
            "",
            "\\end{document}"
        ],
        "description": "授業レポート用テンプレート"
    },

